<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MedRelief | Donor Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .tab-active { background-color: #115e59; color: white; }
    .tab-inactive { background-color: transparent; color: #64748b; }
    .tab-inactive:hover { background-color: #f1f5f9; color: #0f172a; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 h-screen flex overflow-hidden">

  <!-- SIDEBAR (Hidden on small screens, expanded on md+) -->
  <aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col flex-shrink-0">
    <div class="h-16 flex items-center gap-3 px-6 border-b border-slate-200 bg-slate-50">
      <div class="w-8 h-8 rounded-lg bg-teal-600 flex items-center justify-center text-white font-bold text-lg">
        <i class="ph-bold ph-hand-heart"></i>
      </div>
      <div>
        <span class="text-base font-bold text-slate-800 block leading-none">MedRelief</span>
        <span class="text-[10px] text-teal-600 font-semibold uppercase tracking-wider">Donor Portal</span>
      </div>
    </div>

    <nav class="flex-1 p-4 space-y-1.5">
      <button onclick="switchTab('donate')" id="nav-donate" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium tab-active transition">
        <i class="ph ph-plus-circle text-lg"></i> Donate Medicine
      </button>
      <button onclick="switchTab('history')" id="nav-history" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium tab-inactive transition">
        <i class="ph ph-clock-counter-clockwise text-lg"></i> My Donations
      </button>
      <button onclick="switchTab('guidelines')" id="nav-guidelines" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium tab-inactive transition">
        <i class="ph ph-info text-lg"></i> Safety Guidelines
      </button>
    </nav>

    <!-- Mock Donor Profile -->
    <div class="p-4 border-t border-slate-200 bg-slate-50 flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-slate-200 flex items-center justify-center text-sm font-bold text-slate-600">
        RV
      </div>
      <div class="overflow-hidden">
        <p class="text-sm font-semibold text-slate-800 truncate" id="current-donor-name">Rahul Verma</p>
        <p class="text-[11px] text-slate-500 truncate" id="current-donor-email">rahul.v@example.com</p>
      </div>
    </div>
  </aside>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 flex flex-col h-screen overflow-hidden relative">
    
    <!-- MOBILE HEADER -->
    <header class="md:hidden h-14 bg-white border-b border-slate-200 px-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i class="ph-bold ph-hand-heart text-teal-600 text-xl"></i>
        <span class="font-bold text-slate-800">MedRelief</span>
      </div>
      <button class="p-2 text-slate-500"><i class="ph ph-list text-2xl"></i></button>
    </header>

    <div class="flex-1 overflow-y-auto p-4 md:p-8">
      
      <!-- TAB 1: DONATE FORM -->
      <div id="tab-donate" class="max-w-3xl mx-auto space-y-6 block">
        <div>
          <h1 class="text-2xl font-bold text-slate-800">Submit a Donation</h1>
          <p class="text-sm text-slate-500 mt-1">Help reduce medical waste by donating your unused, unexpired medicines to verified NGOs.</p>
        </div>

        <form id="donation-form" onsubmit="submitDonation(event)" class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
          
          <!-- Section 1: Medicine Details -->
          <div class="p-6 border-b border-slate-100 space-y-4">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide flex items-center gap-2">
              <i class="ph ph-pill text-teal-600 text-lg"></i> Medicine Details
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Brand Name <span class="text-rose-500">*</span></label>
                <input type="text" id="brandName" required placeholder="e.g., Augmentin 625 Duo" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Generic Composition <span class="text-rose-500">*</span></label>
                <input type="text" id="genericName" required placeholder="e.g., Amoxicillin" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Manufacturer</label>
                <input type="text" id="manufacturer" placeholder="e.g., GSK" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Disease Category</label>
                <select id="diseaseCategory" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none bg-white">
                  <option value="Antibiotic">Antibiotic</option>
                  <option value="Diabetes">Diabetes</option>
                  <option value="Hypertension">Cardiac / Hypertension</option>
                  <option value="Painkiller">Analgesic / Pain Relief</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Section 2: Batch & Inventory -->
          <div class="p-6 border-b border-slate-100 space-y-4 bg-slate-50/50">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide flex items-center gap-2">
              <i class="ph ph-barcode text-teal-600 text-lg"></i> Batch & Expiry
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Batch Number <span class="text-rose-500">*</span></label>
                <input type="text" id="batchNumber" required placeholder="Found on strip/bottle" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none uppercase">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Expiry Date <span class="text-rose-500">*</span></label>
                <input type="date" id="expiryDate" required class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Quantity <span class="text-rose-500">*</span></label>
                <div class="flex gap-2">
                  <input type="number" id="quantity" required min="1" placeholder="Qty" class="w-20 text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
                  <select id="unitType" class="flex-1 text-sm border border-slate-300 rounded-lg px-2 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none bg-white">
                    <option value="Tablets">Tablets</option>
                    <option value="Capsules">Capsules</option>
                    <option value="Bottles">Bottles</option>
                    <option value="Inhalers">Inhalers</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 3: Safety & Donor Info -->
          <div class="p-6 space-y-4">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide flex items-center gap-2">
              <i class="ph ph-shield-check text-teal-600 text-lg"></i> Safety & Donor Profile
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Donor Category</label>
                <select id="donorType" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none bg-white">
                  <option value="Excess Purchase">Excess Purchase (Individual)</option>
                  <option value="Recovered Patient">Recovered Patient</option>
                  <option value="Physician Sample">Physician Sample</option>
                  <option value="Pharmacy Overstock">Pharmacy Overstock</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Packaging Condition</label>
                <select id="packaging" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none bg-white">
                  <option value="Blister Sealed">Blister Sealed / Intact Strip</option>
                  <option value="Box Sealed">Full Box Sealed</option>
                  <option value="Unopened Bottle">Unopened Bottle</option>
                </select>
              </div>
            </div>

            <!-- Mandatory Safety Check -->
            <div class="mt-4 p-4 bg-amber-50 border border-amber-200 rounded-lg">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" id="isSealIntact" required class="mt-1 w-4 h-4 text-teal-600 border-gray-300 rounded focus:ring-teal-500">
                <span class="text-sm text-amber-900 font-medium leading-snug">
                  I confirm that the primary packaging (foil/bottle seal) is strictly intact and unopened. 
                  <span class="block text-xs text-amber-700 font-normal mt-0.5">Loose tablets or unsealed liquids cannot be accepted for health safety reasons.</span>
                </span>
              </label>
            </div>
          </div>

          <div class="p-6 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
            <button type="reset" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200 rounded-lg transition">Clear Form</button>
            <button type="submit" id="submit-btn" class="px-6 py-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold rounded-lg shadow-sm transition flex items-center gap-2">
              <span>Submit Donation</span>
              <i class="ph-bold ph-arrow-right"></i>
            </button>
          </div>
        </form>
      </div>

      <!-- TAB 2: MY DONATIONS HISTORY -->
      <div id="tab-history" class="max-w-4xl mx-auto space-y-6 hidden">
        <div>
          <h1 class="text-2xl font-bold text-slate-800">My Donation Tracking</h1>
          <p class="text-sm text-slate-500 mt-1">Track the verification and dispatch status of medicines you have contributed.</p>
        </div>

        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
              <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase font-semibold tracking-wider">
                <tr>
                  <th class="px-4 py-3">Donation ID</th>
                  <th class="px-4 py-3">Medicine</th>
                  <th class="px-4 py-3">Qty</th>
                  <th class="px-4 py-3">Submitted On</th>
                  <th class="px-4 py-3">Status</th>
                </tr>
              </thead>
              <tbody id="history-table-body" class="divide-y divide-slate-100">
                <tr>
                  <td colspan="5" class="px-4 py-8 text-center text-slate-500 flex flex-col items-center">
                    <i class="ph ph-spinner-gap animate-spin text-2xl text-teal-600 mb-2"></i>
                    Loading your donations...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    // Configuration - Point this to your backend server URL
    const API_BASE_URL = 'http://localhost:5000/api'; 
    
    // Mock user context (In a real app, this comes from authentication/JWT)
    const CURRENT_USER = {
      name: "Rahul Verma",
      contact: "rahul.v@example.com"
    };

    // --- TAB SWITCHING LOGIC ---
    function switchTab(tabName) {
      document.getElementById('tab-donate').classList.toggle('hidden', tabName !== 'donate');
      document.getElementById('tab-history').classList.toggle('hidden', tabName !== 'history');

      const tabs = ['donate', 'history', 'guidelines'];
      tabs.forEach(t => {
        const el = document.getElementById(`nav-${t}`);
        if(el) {
          if(t === tabName) {
            el.className = "w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium tab-active transition";
          } else {
            el.className = "w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium tab-inactive transition";
          }
        }
      });

      if (tabName === 'history') {
        fetchMyDonations();
      }
    }

    // --- FORM SUBMISSION (POST TO BACKEND) ---
    async function submitDonation(event) {
      event.preventDefault();
      
      const btn = document.getElementById('submit-btn');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="ph ph-spinner-gap animate-spin"></i> Submitting...';
      btn.disabled = true;

      // Construct JSON payload matching the Mongoose Schema
      const payload = {
        drugDetails: {
          brandName: document.getElementById('brandName').value,
          genericName: document.getElementById('genericName').value,
          manufacturer: document.getElementById('manufacturer').value || 'Unknown',
          batchNumber: document.getElementById('batchNumber').value.toUpperCase(),
          expiryDate: document.getElementById('expiryDate').value,
          diseaseCategory: document.getElementById('diseaseCategory').value
        },
        inventory: {
          quantity: parseInt(document.getElementById('quantity').value),
          unitType: document.getElementById('unitType').value,
          estimatedRetailValueINR: 0 // Can be calculated on backend later
        },
        condition: {
          packaging: document.getElementById('packaging').value,
          storageEnvironment: 'Room Temperature', // Default assumption for donor
          isSealIntact: document.getElementById('isSealIntact').checked
        },
        donor: {
          name: CURRENT_USER.name,
          type: document.getElementById('donorType').value,
          contact: CURRENT_USER.contact
        }
      };

      try {
        const response = await fetch(`${API_BASE_URL}/donations`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (response.ok) {
          alert(`Success! Donation ${data.data.donationId} logged for pharmacist verification.`);
          document.getElementById('donation-form').reset();
          switchTab('history'); // Navigate to history to see the new item
        } else {
          alert(`Error: ${data.error || 'Failed to submit donation'}`);
        }
      } catch (error) {
        console.error('Submit Error:', error);
        alert('Network Error: Could not connect to the server. Please ensure the MedRelief backend is running on port 5000.');
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }

    // --- FETCH HISTORY (GET FROM BACKEND) ---
    async function fetchMyDonations() {
      const tbody = document.getElementById('history-table-body');
      tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-slate-500">Loading...</td></tr>';

      try {
        const response = await fetch(`${API_BASE_URL}/donations`);
        const data = await response.json();

        if (response.ok) {
          // Filter frontend-side to only show this user's donations
          const myDonations = data.data.filter(d => d.donor.contact === CURRENT_USER.contact);
          renderHistory(myDonations);
        } else {
          tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-4 text-center text-rose-500">Failed to load data.</td></tr>`;
        }
      } catch (error) {
        console.error('Fetch Error:', error);
        tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-4 text-center text-slate-500">Could not connect to server. Ensure backend is running.</td></tr>`;
      }
    }

    function renderHistory(donations) {
      const tbody = document.getElementById('history-table-body');
      tbody.innerHTML = '';

      if (donations.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-slate-500">You haven\'t made any donations yet.</td></tr>';
        return;
      }

      donations.forEach(donation => {
        // Format Date
        const dateStr = new Date(donation.lifecycle.submissionDate).toLocaleDateString('en-IN', {
          day: '2-digit', month: 'short', year: 'numeric'
        });

        // Determine Status Badge Color
        let statusBadge = '';
        const status = donation.lifecycle.status;
        if (status === 'Pending_Verification') {
          statusBadge = '<span class="bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase">Pending QA</span>';
        } else if (status === 'Verified_Active') {
          statusBadge = '<span class="bg-teal-100 text-teal-700 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase">Verified Stock</span>';
        } else if (status === 'Dispatched') {
          statusBadge = '<span class="bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase">Given to NGO</span>';
        } else {
          statusBadge = '<span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase">Rejected (Unsafe)</span>';
        }

        const row = document.createElement('tr');
        row.className = "hover:bg-slate-50 transition border-b border-slate-50 last:border-0";
        row.innerHTML = `
          <td class="px-4 py-3 font-mono font-medium text-slate-600">${donation.donationId}</td>
          <td class="px-4 py-3 font-semibold text-slate-800">${donation.drugDetails.brandName} <span class="block text-xs font-normal text-slate-500">${donation.drugDetails.batchNumber}</span></td>
          <td class="px-4 py-3 text-slate-700">${donation.inventory.quantity} ${donation.inventory.unitType}</td>
          <td class="px-4 py-3 text-slate-600">${dateStr}</td>
          <td class="px-4 py-3">${statusBadge}</td>
        `;
        tbody.appendChild(row);
      });
    }

    // Initialize minimum expiry date to today to prevent past dates
    document.addEventListener("DOMContentLoaded", () => {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById("expiryDate").setAttribute('min', today);
    });
  </script>
</body>
</html>
